<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NetUM.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NetUM">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <InfoBar x:Name="AlertBar" Grid.Row="0" IsOpen="False" Severity="Warning"
                 Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- Header -->
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="12" Padding="16" Margin="0,0,0,4"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="42" Height="42" CornerRadius="21"
                                    Background="#1C2434"
                                    BorderBrush="#315579"
                                    BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="&#x25BC;" FontSize="12" FontWeight="Bold"
                                               Foreground="#48D660"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>
                                    <TextBlock Text="&#x25B2;" FontSize="12" FontWeight="Bold"
                                               Foreground="#FFA532"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="NetUM" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="Live network usage at a glance"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Click="OnShowHistoryClick"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="14,8"
                                MinWidth="110">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Library"/>
                                <TextBlock Text="History" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Current Speed Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="CURRENT SPEED" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   CharacterSpacing="60"/>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="&#x25BC; Download" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DownloadSpeedText" Text="0 KB/s"
                                           FontSize="18" FontWeight="SemiBold" Foreground="#48D660"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="&#x25B2; Upload" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="UploadSpeedText" Text="0 KB/s"
                                           FontSize="18" FontWeight="SemiBold" Foreground="#FFA532"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Today's Usage Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="TODAY'S USAGE" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   CharacterSpacing="60"/>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="&#x25BC; Downloaded" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TodayDownText" Text="0 B"
                                           FontSize="16" FontWeight="SemiBold" Foreground="#48D660"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="&#x25B2; Uploaded" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TodayUpText" Text="0 B"
                                           FontSize="16" FontWeight="SemiBold" Foreground="#FFA532"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- This Month Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="THIS MONTH" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   CharacterSpacing="60"/>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="&#x25BC; Downloaded" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="MonthDownText" Text="0 B"
                                           FontSize="16" FontWeight="SemiBold" Foreground="#48D660"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="&#x25B2; Uploaded" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="MonthUpText" Text="0 B"
                                           FontSize="16" FontWeight="SemiBold" Foreground="#FFA532"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Settings Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <ToggleSwitch x:Name="AlwaysOnTopToggle"
                                      Header="Always on Top"
                                      Toggled="OnAlwaysOnTopToggled"/>
                        <ToggleSwitch x:Name="StartupToggle"
                                      Header="Run at startup"
                                      Toggled="OnStartupToggled"/>
                    </StackPanel>
                </Border>

                <!-- Reset Button -->
                <Button Content="Reset All Data" Click="OnResetDataClick"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
