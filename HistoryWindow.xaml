<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NetUM.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NetUM — Usage History">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Control Panel -->
        <StackPanel Grid.Row="0" Spacing="10">

            <!-- Row 1: Group, Range, Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="GroupByCombo" Header="Group by" Width="120"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Day" IsSelected="True"/>
                    <ComboBoxItem Content="Week"/>
                    <ComboBoxItem Content="Month"/>
                </ComboBox>

                <ComboBox x:Name="RangeCombo" Header="Range" Width="150"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Last 7 periods"/>
                    <ComboBoxItem Content="Last 30 periods" IsSelected="True"/>
                    <ComboBoxItem Content="Last 90 periods"/>
                    <ComboBoxItem Content="All history"/>
                </ComboBox>

                <Button Content="Refresh" VerticalAlignment="Bottom" Margin="0,0,0,0"
                        Click="OnRefreshClick"/>
                <Button Content="Export CSV" VerticalAlignment="Bottom"
                        Click="OnExportCsvClick"/>
                <Button Content="Reset All" VerticalAlignment="Bottom"
                        Click="OnResetClick"/>
            </StackPanel>

            <!-- Row 2: Cap Settings -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <NumberBox x:Name="DailyCapInput" Header="Daily cap (GB)"
                           SpinButtonPlacementMode="Compact" Width="160"
                           Minimum="0" Maximum="999999" SmallChange="0.25" LargeChange="1"/>

                <NumberBox x:Name="MonthlyCapInput" Header="Monthly cap (GB)"
                           SpinButtonPlacementMode="Compact" Width="160"
                           Minimum="0" Maximum="999999" SmallChange="0.5" LargeChange="5"/>

                <Button Content="Save Caps" VerticalAlignment="Bottom"
                        Click="OnSaveCapsClick"/>

                <TextBlock x:Name="CapStatusText" Text="Caps: disabled"
                           VerticalAlignment="Bottom" Margin="8,0,0,8"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Summary Row -->
        <Grid Grid.Row="1" Margin="0,12,0,8" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="SummaryText" Text="Totals: —"
                       TextWrapping="Wrap"/>
            <TextBlock Grid.Column="1" x:Name="AverageText" Text="Average: —"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="2" x:Name="PeakText" Text="Peak: —"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <!-- Content Pivot -->
        <Pivot Grid.Row="2" x:Name="ContentPivot">

            <!-- History Tab -->
            <PivotItem Header="History">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Chart -->
                    <Border Grid.Row="0" Background="#14141C" CornerRadius="6" Margin="0,0,0,8">
                        <Canvas x:Name="ChartCanvas" SizeChanged="OnChartSizeChanged"/>
                    </Border>

                    <!-- Table Header -->
                    <Grid Grid.Row="1" Padding="12,8"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                          CornerRadius="4,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <HyperlinkButton Grid.Column="0" x:Name="SortPeriodBtn" Content="Period ▼"
                                         Click="OnSortPeriod" Padding="0"/>
                        <HyperlinkButton Grid.Column="1" x:Name="SortDownBtn" Content="Downloaded"
                                         Click="OnSortDown" Padding="0"/>
                        <HyperlinkButton Grid.Column="2" x:Name="SortUpBtn" Content="Uploaded"
                                         Click="OnSortUp" Padding="0"/>
                        <HyperlinkButton Grid.Column="3" x:Name="SortTotalBtn" Content="Total"
                                         Click="OnSortTotal" Padding="0"/>
                    </Grid>

                    <!-- History Data -->
                    <ListView Grid.Row="2" x:Name="HistoryList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Period}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Downloaded}"
                                               Foreground="#48D660"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Uploaded}"
                                               Foreground="#FFA532"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Total}"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- Adapters Tab -->
            <PivotItem Header="Adapters">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="AdapterSummaryText"
                               Text="Adapter totals: —" Margin="0,0,0,8"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- Adapter Header -->
                    <Grid Grid.Row="1" Padding="12,8"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                          CornerRadius="4,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Adapter" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Downloaded" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Uploaded" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Total" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="Share" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Adapter Data -->
                    <ListView Grid.Row="2" x:Name="AdapterList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding AdapterName}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AdapterType}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Downloaded}"
                                               Foreground="#48D660"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Uploaded}"
                                               Foreground="#FFA532"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Total}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Share}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Window>
